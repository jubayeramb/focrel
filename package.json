{
  "name": "focrel",
  "private": true,
  "version": "0.1.0",
  "description": "Focrel monorepo — context-switching focus app (desktop, web)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "desktop": "pnpm --filter @focrel/desktop",
    "desktop:dev": "pnpm --filter @focrel/desktop tauri:dev",
    "desktop:build": "pnpm --filter @focrel/desktop tauri:build",
    "web": "pnpm --filter @focrel/web",
    "web:dev": "pnpm --filter @focrel/web dev",
    "web:build": "pnpm --filter @focrel/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.0",
    "wrangler": "^4.84.1"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  }
}
