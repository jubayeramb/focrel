# Allow `pnpm add <pkg>` at the workspace root without the `-w` flag.
# Tooling like cloudflare/wrangler-action installs binaries at the root
# during CI, and pnpm refuses by default. This relaxes that check so the
# action can top-up wrangler if the installed version doesn't match its
# default. Local day-to-day adds still land in the right workspace because
# developers use `pnpm --filter <pkg> add <dep>`.
ignore-workspace-root-check=true
